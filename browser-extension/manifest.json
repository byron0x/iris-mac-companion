{
  "manifest_version": 3,
  "name": "IRIS — Your browser guardian companion",
  "version": "0.2.0",
  "description": "Review extension access, watch for changes, and check links or recent browsing for known crypto-phishing domains locally.",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": [
    "management",
    "storage",
    "declarativeNetRequest",
    "alarms"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Review browser security with IRIS",
    "default_icon": {
      "16": "assets/iris-16.png",
      "32": "assets/iris-32.png",
      "128": "assets/iris-128.png"
    }
  },
  "icons": {
    "16": "assets/iris-16.png",
    "48": "assets/iris-48.png",
    "128": "assets/iris-128.png"
  },
  "options_page": "review.html",
  "externally_connectable": {
    "matches": [
      "https://app.undercoveriris.io/*"
    ]
  },
  "incognito": "not_allowed",
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'self' https://raw.githubusercontent.com; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
  },
  "short_name": "IRIS Companion",
  "optional_permissions": [
    "history",
    "webNavigation"
  ]
}
